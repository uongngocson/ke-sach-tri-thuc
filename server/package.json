{
  "name": "caosach-server",
  "version": "1.0.0",
  "description": "Production Node.js Express & PostgreSQL Real-time Server for Cáo Sách",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node scripts/run-all-test-suites.js",
    "test:security": "node scripts/test-security-fullkey.js",
    "test:concurrency": "node scripts/test-realtime-concurrency-fullkey.js",
    "test:daynight": "node scripts/test-day-night-fullkey.js",
    "test:watering": "node scripts/test-watering-and-likes-fullkey.js",
    "test:groq": "node scripts/test-groq-pool.js",
    "test:queue": "node scripts/test-credibility-queue.js",
    "test:lifecycle": "node scripts/test-288-users-full-lifecycle.js",
    "test:all": "npm test && npm run test:lifecycle"
