# Environment configuration template for Cáo Sách
PORT=5005
NODE_ENV=production
CLIENT_ORIGIN=https://caosach.soninfra.cloud

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=5436
DB_NAME=caosach_db
DB_USER=caosach_user
DB_PASSWORD=your_secure_db_password_here

# Security Secrets
JWT_SECRET=your_super_secret_jwt_key_here
BCRYPT_ROUNDS=10
ADMIN_DEFAULT_PASSWORD=your_admin_password_here

# Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
